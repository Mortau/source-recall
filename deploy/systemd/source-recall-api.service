[Unit]
Description=SourceRecall repository intelligence API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=aiadmin
Group=aiadmin
WorkingDirectory=/opt/source-recall
Environment=SOURCE_RECALL_CONFIG=/etc/source-recall/source-recall.yaml
ExecStart=/opt/source-recall/.venv/bin/source-recall-api

Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=300
UMask=0027
LimitNOFILE=65535

StateDirectory=source-recall
StateDirectoryMode=0750
LogsDirectory=source-recall
LogsDirectoryMode=0750
StandardOutput=journal
StandardError=journal
SyslogIdentifier=source-recall-api

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/source-recall/repositories
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
